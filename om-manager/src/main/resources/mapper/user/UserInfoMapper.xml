<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cola.omlink.manager.mapper.UserInfoMapper">

    <resultMap id="userInfoMap" type="com.cola.omlink.repository.entity.user.UserInfo" autoMapping="true"></resultMap>

    <!--    用于公共抽取的列-->
    <sql id="columns">
        id,user_id,om_value,credit,photo,my_position,university,profile,user_role
    </sql>

    <select id="selectByUserId" resultMap="userInfoMap">
        select <include refid="columns" />
            from o_user_info
            where user_id = #{userId}
                    and deleted = 0
    </select>



</mapper>